# ==============================================================================
# Prvo Environment Configuration (.env.example)
# Copy this file to .env before running the application locally.
# Never commit .env with real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Application URLs
# Single source of truth is packages/shared/src/brand.ts; these override defaults.
# ------------------------------------------------------------------------------
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
LANDING_URL=http://localhost:3001
PORT=4000
NODE_ENV=development

# ------------------------------------------------------------------------------
# Database (Neon Serverless PostgreSQL)
# DATABASE_URL: Pooled connection string used for high-concurrency runtime queries.
# DATABASE_URL_UNPOOLED: Direct, unpooled connection string used for migrations & DDL.
# Example: postgresql://[user]:[password]@[endpoint]-pooler.[region].aws.neon.tech/neondb?sslmode=require
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# Authentication / JWT
# Minimum 32-character high-entropy secret strings for token signing.
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=super_secret_access_jwt_key_at_least_32_characters_long
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_at_least_32_characters_long

# ------------------------------------------------------------------------------
# AI Provider: Google Gemini behind an LLMService interface; model names come from env.
# Optional in development/test, but STRICTLY REQUIRED in production.
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MODEL_FAST=gemini-3.1-flash-lite

# ------------------------------------------------------------------------------
# Web Search & OAuth Providers
# Optional in development/test, but STRICTLY REQUIRED in production.
# ------------------------------------------------------------------------------
TAVILY_API_KEY=
BRAVE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# Public Web App Environment (Next.js)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_LANDING_URL=http://localhost:3001
